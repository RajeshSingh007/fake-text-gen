---
// HeroWave — the flowing silk-ribbon backdrop for the v3 hero.
// The approved wave.webp is shown directly as an <img> (Astro fingerprints it),
// with a faint, slow breathing/drift so it feels alive without any warp.
// Pure CSS — zero JS, no three.js.
import waveImg from '../../assets/wave.webp';
---

<div class="hero-wave" aria-hidden="true">
  <img
    class="hero-wave-img"
    src={waveImg.src}
    width={waveImg.width}
    height={waveImg.height}
    alt=""
    decoding="async"
    fetchpriority="high"
  />
</div>

<style>
  .hero-wave {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    
  }
  .hero-wave-img {
    position: absolute;
    top: 50%;
    right: 0;
    height: 110%;
    width: auto;
    max-width: none;
    display: block;
    transform: translateY(-50%);
    transform-origin: right center;
    will-change: transform;
    /* Faint breathing/drift only — no ripple/warp. */
    animation: hero-wave-flow 5s ease-in-out infinite;
  }

  @keyframes hero-wave-flow {
    0%   { transform: translateY(-50%) scale(1.01); }
    50%  { transform: translateY(-52%) translateX(-0.8%) scale(1.03); }
    100% { transform: translateY(-50%) scale(1.01); }
  }

  @media (max-width: 960px) {
    /* On mobile the mock card is reordered to the TOP of the hero, so anchor the
       wave to the upper band (behind the card) and fade its lower edge softly
       into the copy below. */
    .hero-wave { top: 0; bottom: auto; height: 58%; -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 68%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0%, #000 68%, transparent 100%); }
    .hero-wave-img {
      top: 0; right: 0;
      height: 100%; width: 100%;
      object-fit: cover;
      object-position: 72% center;
      transform: none;
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wave-img {
      animation: none;
      transform: translateY(-50%) scale(1.01);
    }
  }
</style>
